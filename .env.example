# Copy to .env.local for local development. In CI these come from GitHub repo Variables.
# Supabase → Project Settings → API. The anon/publishable key is safe to ship in the app;
# Row Level Security (supabase/schema.sql) is what protects your data.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-OR-PUBLISHABLE-KEY"

# Shown in Settings and required by Google Play
VITE_SUPPORT_EMAIL="you@example.com"
VITE_PRIVACY_POLICY_URL="https://nitishbhardwaj-7.github.io/Ishvara/privacy.html"
